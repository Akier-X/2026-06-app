# Anthropic APIキー (https://platform.claude.com で発行)
ANTHROPIC_API_KEY=sk-ant-...

# 任意: アプリからのリクエストにのみ応答させる共有トークン
COACH_APP_TOKEN=

# フィードバック閲覧用の管理トークン (GET /api/feedback に必要。ランダムな長い文字列に)
ADMIN_TOKEN=

# 任意: フィードバック保存先 (デフォルト ./data/feedback.jsonl)
FEEDBACK_FILE=./data/feedback.jsonl

# 任意: ポート (デフォルト 8787)
PORT=8787
